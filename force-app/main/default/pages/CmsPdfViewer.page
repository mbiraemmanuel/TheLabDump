<apex:page controller="CmsPdfController" 
           showHeader="false" 
           sidebar="false" 
           standardStylesheets="false"
           cache="false">
    <html>
    <head>
        <style>
            body { margin: 0; padding: 10px; font-family: Arial, sans-serif; }
            .debug { background: #f0f0f0; padding: 10px; margin-bottom: 10px; }
            .error { color: red; padding: 20px; background: #fef5e7; border: 1px solid #f39c12; }
            iframe { width: 100%; height: 80vh; border: none; }
        </style>
    </head>
    <body>
        <div class="debug">
            Debug Info:<br/>
            Content Key: {!contentKey}<br/>
            Language: {!language}<br/>
        </div>
        
        <apex:outputText value="{!pdfBlob}" escape="false"/>
    </body>
    </html>
</apex:page>
